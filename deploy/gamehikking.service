[Unit]
Description=GameHikking Streamlit app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sysadmin
WorkingDirectory=/home/sysadmin/2026-GameHikking
ExecStart=/home/sysadmin/2026-GameHikking/.venv/bin/streamlit run app.py --server.port 8510 --server.headless true --server.address 127.0.0.1 --browser.gatherUsageStats false
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# 질문 로그(query_log.py)는 저장소 밖에 쌓는다: 저장소를 새로 받거나 정리해도 로그가 남도록
Environment=GH_LOG_DIR=/home/sysadmin/gamehikking-logs

[Install]
WantedBy=multi-user.target
